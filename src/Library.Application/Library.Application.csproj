<Project Sdk="Microsoft.NET.Sdk">

  <!--
    APPLICATION LAYER - use cases, DTOs, validators, and the ABSTRACTIONS
    (IBookRepository, IClock, IFileStorage, ITokenService, ...) that
    Library.Infrastructure implements.

    Note what is absent: no EF Core reference. This layer talks about
    persistence through interfaces it owns, which is Dependency Inversion
    enforced by the compiler rather than by good intentions.
  -->

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Mapster" />
    <PackageReference Include="Mapster.DependencyInjection" />

    <!-- Needed by AddApplication to bind and validate FineOptions. These are
         abstractions only - no configuration PROVIDER is referenced here, so the
         layer still knows nothing about where settings come from. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Library.Domain\Library.Domain.csproj" />
  </ItemGroup>

</Project>
