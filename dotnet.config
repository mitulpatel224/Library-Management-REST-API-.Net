# Selects the test runner used by `dotnet test`.
#
# The .NET 10 SDK no longer supports running tests through the old VSTest bridge.
# Microsoft.Testing.Platform (MTP) is the replacement: each test project builds
# as an executable that hosts its own runner, so `dotnet test` simply launches it.
#
# xUnit v3 targets MTP natively, which is why this project references neither
# Microsoft.NET.Test.Sdk nor xunit.runner.visualstudio - both belong to the VSTest
# world. Without this file, `dotnet test` fails with:
#   "Testing with VSTest target is no longer supported by Microsoft.Testing.Platform
#    on .NET 10 SDK and later."
[dotnet.test.runner]
name = "Microsoft.Testing.Platform"
