<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UNIT TESTS - fast, no I/O, no database, no HTTP.
    References Domain and Application only. If a test here needs a database,
    it belongs in Library.IntegrationTests instead.
  -->

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Library.Domain\Library.Domain.csproj" />
    <ProjectReference Include="..\..\src\Library.Application\Library.Application.csproj" />

    <!--
      Infrastructure is referenced for the import READERS only.

      The rule this project holds to is behavioural, not structural: a unit test
      does no I/O. The CSV and JSON readers qualify - they are pure parsers over
      a Stream, and these tests run them against a MemoryStream with no database
      and no HTTP.

      What must NOT appear here is a test that constructs a DbContext or a
      repository. Those need a real schema to mean anything, and they belong in
      Library.IntegrationTests where one exists.
    -->
    <ProjectReference Include="..\..\src\Library.Infrastructure\Library.Infrastructure.csproj" />
  </ItemGroup>

</Project>
